            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:launchMode="singleTask" android:exported="false" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
        </activity>
    </application>
</manifest>
